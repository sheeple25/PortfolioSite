{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    /* Stricter than the Next.js baseline, kept deliberately. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    /*
     * Dev-only generated route types. `next dev` writes these from the dev
     * route set, which now legitimately differs from production: the labs
     * under `app/(labs)` are `*.dev.tsx` and only resolve in development
     * (see `pageExtensions` in next.config.ts). Typechecking both sets at
     * once makes `next build` fail whenever a dev server happens to be
     * running. Excluded here rather than removed from `include` because
     * `next dev` rewrites `include` on startup; `exclude` wins over it and
     * survives. `.next/types/**` (the production set) is still checked.
     */
    ".next/dev/types/**/*"
  ]
}
