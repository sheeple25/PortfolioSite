{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    /* Stricter than the Next.js baseline, kept deliberately. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    /*
     * Dev-only generated route types. `next dev` writes these from whatever
     * route set was live when it last ran, and typechecking that alongside the
     * production set makes `next build` fail whenever a dev server happens to
     * be running against a stale set.
     *
     * This was originally needed because the `app/(labs)` sandboxes resolved
     * only in development, so the two sets genuinely differed. The labs are
     * gone and the sets now match, but the exclusion stays: a stale dev
     * snapshot can still disagree with the current routes, and this is the
     * cheap guard against it. Excluded here rather than removed from `include`
     * because `next dev` rewrites `include` on startup; `exclude` wins over it
     * and survives. `.next/types/**` (the production set) is still checked.
     */
    ".next/dev/types/**/*"
  ]
}
